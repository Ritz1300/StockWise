# ==============================================================================
# StockWise Backend Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MongoDB Atlas Database Connection
# ------------------------------------------------------------------------------
# 1. Sign in to MongoDB Atlas (https://cloud.mongodb.com)
# 2. Go to your Database Deployment -> Click "Connect" -> Choose "Drivers" (Node.js)
# 3. Paste your connection string below, replacing <username> and <password>
#
# If running MongoDB locally, you can use: mongodb://127.0.0.1:27017/stockwise
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stockwise?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication Security (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=stockwise_super_secret_jwt_key_replace_in_production_2026
JWT_EXPIRE=7d